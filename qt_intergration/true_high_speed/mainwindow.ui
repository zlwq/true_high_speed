   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget { background: #f4f6f9; }
QLabel#titleLabel { color: #172033; font-size: 25px; font-weight: 600; }
QLabel#subtitleLabel { color: #667085; font-size: 13px; }
QLabel#videoPathLabel, QLabel#statusLabel { color: #344054; }
QLineEdit { min-height: 34px; padding: 0 10px; background: white; border: 1px solid #d0d5dd; border-radius: 6px; }
QPushButton { min-height: 36px; padding: 0 18px; border: 1px solid #c7cdd8; border-radius: 7px; background: white; color: #273142; }
QPushButton:hover { background: #f1f5ff; border-color: #7b98df; }
QPushButton:disabled { color: #98a2b3; background: #eaecf0; }
QPushButton#ringSchemeButton, QPushButton#localtrackButton, QPushButton#trackonButton, QPushButton#tapSchemeButton { min-height: 56px; font-size: 15px; font-weight: 600; }
QPushButton#ringSchemeButton { color: white; background: #3867d6; border-color: #3867d6; }
QPushButton#ringSchemeButton:hover { background: #2f5bbd; }
QPushButton#localtrackButton, QPushButton#trackonButton, QPushButton#tapSchemeButton { color: white; background: #6c4bc1; border-color: #6c4bc1; }
QPushButton#localtrackButton:hover, QPushButton#trackonButton:hover, QPushButton#tapSchemeButton:hover { background: #5c3fac; }
QPushButton#physicalAnalysisButton, QPushButton#ReviewButton { color: white; background: #3867d6; border-color: #3867d6; }
QPushButton#physicalAnalysisButton:hover, QPushButton#ReviewButton:hover { background: #2f5bbd; }
QProgressBar { min-height: 20px; border: 1px solid #d0d5dd; border-radius: 6px; background: white; text-align: center; }
QProgressBar::chunk { border-radius: 5px; background: #3867d6; }</string>
